# Yukisei - Configuración opcional de entorno (Plantilla de ejemplo)
# Copia este archivo como .env si necesitas personalizar URLs o puertos locales.

# URL de desarrollo para Vite (opcional, por defecto http://localhost:5180/)
# YUKISEI_DEV_URL=http://localhost:5180/

# URL del servidor local de Ollama (por defecto http://127.0.0.1:11434)
# OLLAMA_BASE_URL=http://127.0.0.1:11434

# URL del servidor local de Player 2 (opcional para TTS gamer local)
# PLAYER2_URL=http://localhost:4315/v1

